{
	"name": "flarum-lang/russian",
	"description": "Russian Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/russian",
	"license": "MIT",
	"authors": [
		{
			"name": "KaiKimera",
			"homepage": "https://github.com/KaiKimera",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/russian/issues",
		"forum": "https://discuss.flarum.org/d/1545",
		"source": "https://github.com/flarum-lang/russian"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Russian",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#ffffff",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "ru",
			"title": "Русский"
		}
	}
}
